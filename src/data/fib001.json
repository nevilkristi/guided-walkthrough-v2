{
  "id": "FIB-001",
  "name": "Philips Albuquerque RF-Chip Fire (2000) — Nokia vs. Ericsson",
  "industry": "Electronics",
  "brand_group": "Supplier: Royal Philips Electronics (Fab 22). Customers: Nokia & Ericsson.",
  "comic": "/comics/FIB-001",
  "nature": "Disruption",
  "scale": "Plant served ~30 customers; Nokia & Ericsson together ~40% of output. In 2000 Nokia was #1 handset maker (~30.6% share), Ericsson #3 (~9.7%).",
  "normal_flow_nodes": [
    {
      "label": "Node 1 – Supplier (Philips)",
      "description": "Royal Philips RF/ASIC chip fab (Fab 22), Albuquerque, New Mexico; single/critical source for handset RF chips."
    },
    {
      "label": "Node 2 – Manufacturer (Nokia & Ericsson)",
      "description": "Nordic handset OEMs integrating Philips RF chips into mobile phones; lean/JIT inbound, low buffers."
    },
    {
      "label": "Node 3 – Logistics & Export",
      "description": "Chips shipped from New Mexico to European/Asian assembly; near-JIT, minimal safety stock."
    },
    {
      "label": "Node 4 – Customers",
      "description": "Mobile operators, retailers and consumers in the booming 2000 GSM market; short product cycles."
    }
  ],
  "normal_flow_steps": [
    {
      "step": 1,
      "process": "Philips fabricates RF/ASIC chips in clean-room lines",
      "node": "Supplier"
    },
    {
      "step": 2,
      "process": "Chips shipped to Nokia & Ericsson (lean/JIT inbound)",
      "node": "Logistics"
    },
    {
      "step": 3,
      "process": "Handset assembly integrates chips into phones",
      "node": "Manufacturer"
    },
    {
      "step": 4,
      "process": "Phones distributed via operators/retailers to consumers",
      "node": "Customer"
    }
  ],
  "kpis": [
    {
      "label": "Cost",
      "value": "High-value, high-margin custom RF/ASIC chips; Philips' own loss from the fire ~$40M."
    },
    {
      "label": "Lead Time",
      "value": "Weeks (semiconductor cycle); lean/JIT inbound, no buffer; Ericsson single-sourced."
    },
    {
      "label": "CO₂ Impact",
      "value": "High (semiconductor fabrication energy/water intensive) – industry norm, not case data."
    },
    {
      "label": "Waste",
      "value": "Clean-room dependency: any contamination = total stock loss (as the fire showed)."
    },
    {
      "label": "Customer Satisfaction",
      "value": "High pre-fire (reliable, trusted primary source)."
    },
    {
      "label": "Risk",
      "value": "HIGH but unrecognised: single-plant concentration, single-sourcing, no contingency, slow escalation."
    },
    {
      "label": "Quality",
      "value": "Very high (clean-room ~1 particle/m3; custom ASIC, no drop-in substitute)."
    },
    {
      "label": "Sustainability",
      "value": "Not tracked for a 2000 semiconductor fab."
    },
    {
      "label": "Circular Economy",
      "value": "Low (minimal chip reuse/recycling in 2000)."
    }
  ],
  "disruption": [
    {
      "label": "Trigger event",
      "value": "17 Mar 2000: lightning strike/power surge ignited a fire in a Philips Albuquerque clean room; extinguished in ~10 min."
    },
    {
      "label": "Root cause details",
      "value": "Smoke/soot/water contaminated the clean room, destroying almost the entire RF-chip stock. Customer-side: Ericsson single-sourcing, lean/JIT, single-plant concentration, slow escalation. Philips first estimated ~1 week recovery; actual recovery took months."
    },
    {
      "label": "Affected nodes",
      "value": "Supplier (Philips: production halted, stock lost); Manufacturer (Nokia & Ericsson chip supply cut; Ericsson ~7M-phone shortfall); Logistics (inbound severed); Customer (delayed shipments, T36 launch delay)."
    },
    {
      "label": "Effect on Supply chain",
      "value": "Nokia: minor delays (early detection + re-sourcing). Ericsson: ~$400M direct loss, ~7M-phone shortfall, lost market share, exit from standalone handsets (Sony Ericsson JV, Oct 2001). Philips: ~$40M loss; plant closed 2003."
    }
  ],
